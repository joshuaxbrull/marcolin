{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "marcolin-manager",
  "account_id": "f1afb0e98752eec18d3fa2eaa2c3a34f",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "PORTAL_ORIGIN": "https://marcolin-manager.marcolin-event-locator.workers.dev",
    "GITHUB_CLIENT_ID": "Iv23liD6i6TvbjcfR2TK"
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "secrets": {
    "required": [
      "GITHUB_CLIENT_SECRET",
      "SESSION_SECRET"
    ]
  }
}
